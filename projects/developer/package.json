{
  "name": "@trakt/developer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "dev:local": "vite dev --host localhost --port 5174 --strictPort",
    "build": "vite build && deno run -A scripts/check-client-secrets.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --run",
    "format:svelte": "prettier --write \"src/**/*.svelte\"",
    "format:svelte:check": "prettier --check \"src/**/*.svelte\""
  },
  "dependencies": {
    "@sveltejs/kit": "2.70.2",
    "marked": "18.0.10",
    "svelte": "5.56.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.4",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "sass": "1.102.0",
    "wrangler": "4.103.0"
  }
}
